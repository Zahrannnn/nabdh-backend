generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [postgis, vector]
}

// ──────────────────────────────────────────────
// --- module: users ---
// ──────────────────────────────────────────────

enum UserType {
  PATIENT
  NURSE
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum NurseStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
  OFFLINE
  ONLINE
  ON_DUTY
}

model User {
  id            String    @id @default(uuid())
  phone         String    @unique
  email         String?
  type          UserType
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  patient          Patient?
  nurse            Nurse?
  otpSessions      OtpSession[]
  refreshTokens    RefreshToken[]
  chatMessages     ChatMessage[] @relation("chat_sender")
  chatReceivedMessages ChatMessage[] @relation("chat_receiver")
  notifications    Notification[]

  @@map("users")
}

model Patient {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  dateOfBirth    DateTime?
  gender         Gender?
  avatarUrl      String?
  addresses      Address[]
  serviceRequests ServiceRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("patients")
}

model Nurse {
  id                    String          @id @default(uuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName             String
  lastName              String
  dateOfBirth           DateTime?
  gender                Gender?
  avatarUrl             String?
  licenseNumber         String          @unique
  licenseExpiryDate     DateTime
  yearsOfExperience    Int             @default(0)
  bio                   String?
  hourlyRate            Decimal         @default(0)
  status                NurseStatus     @default(PENDING_VERIFICATION)
  isVerified            Boolean         @default(false)
  verificationSlaDeadline DateTime?
  averageRating         Decimal         @default(0)
  totalRatings          Int             @default(0)
  location              LocationHistory?
  addresses             Address[]
  nurseDocuments        NurseDocument[]
  offers                Offer[]
  bookings              Booking[]
  payments              Payment[]
  wallet                Wallet?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("nurses")
}

model Address {
  id          String   @id @default(uuid())
  label       String?
  governorate String
  city        String
  district    String
  street      String?
  building    String?
  apartment   String?
  latitude    Decimal?
  longitude   Decimal?
  isDefault   Boolean  @default(false)
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nurseId     String?
  nurse       Nurse?   @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("addresses")
}

model NurseDocument {
  id          String   @id @default(uuid())
  nurseId     String
  nurse       Nurse    @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  type        String
  fileUrl     String
  isVerified  Boolean  @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("nurse_documents")
}

// ──────────────────────────────────────────────
// --- module: auth ---
// ──────────────────────────────────────────────

model OtpSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String
  method     String   @default("SMS")
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("otp_sessions")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────
// --- module: booking ---
// ──────────────────────────────────────────────

enum BookingStatus {
  PENDING_OFFERS
  NURSE_CONFIRMED
  NURSE_EN_ROUTE
  NURSE_ARRIVED
  VISIT_IN_PROGRESS
  VISIT_COMPLETED
  CANCELLED
  DISPUTED
}

enum RequestType {
  STANDARD
  SOS
  SCHEDULED
}

enum PaymentMethod {
  CASH
  CARD
  FAWRY
}

model ServiceRequest {
  id             String       @id @default(uuid())
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           RequestType  @default(STANDARD)
  description    String?
  requiredGender Gender?
  latitude       Decimal
  longitude      Decimal
  addressId      String?
  address        Address?     @relation(fields: [addressId], references: [id])
  scheduledAt    DateTime?
  durationMinutes Int         @default(60)
  status         BookingStatus @default(PENDING_OFFERS)
  paymentMethod  PaymentMethod @default(CASH)
  offers         Offer[]
  booking        Booking?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("service_requests")
}

model Offer {
  id              String          @id @default(uuid())
  serviceRequestId String
  serviceRequest  ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  nurseId         String
  nurse           Nurse           @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  price           Decimal
  isSelected      Boolean         @default(false)
  isDeclined      Boolean         @default(false)
  declinedReason  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("offers")
}

model Booking {
  id              String        @id @default(uuid())
  serviceRequestId String        @unique
  serviceRequest  ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  nurseId         String
  nurse           Nurse          @relation(fields: [nurseId], references: [id])
  status          BookingStatus
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  rating          Rating?
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("bookings")
}

model Rating {
  id        String   @id @default(uuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("ratings")
}

// ──────────────────────────────────────────────
// --- module: payment ---
// ──────────────────────────────────────────────

enum TransactionType {
  COMMISSION
  WITHDRAWAL
  PAYMENT
  REFUND
  BONUS
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String?
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  nurseId        String?
  nurse          Nurse?        @relation(fields: [nurseId], references: [id])
  amount         Decimal
  commission     Decimal       @default(0)
  netAmount      Decimal
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionId  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("payments")
}

model Wallet {
  id        String             @id @default(uuid())
  nurseId   String             @unique
  nurse     Nurse              @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  balance   Decimal            @default(0)
  transactions WalletTransaction[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id          String          @id @default(uuid())
  walletId    String
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal
  balanceBefore Decimal
  balanceAfter  Decimal
  reference   String?
  description String?
  createdAt   DateTime        @default(now())

  @@map("wallet_transactions")
}

// ──────────────────────────────────────────────
// --- module: notifications ---
// ──────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  channel   String   @default("IN_APP")
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ──────────────────────────────────────────────
// --- module: chat ---
// ──────────────────────────────────────────────

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("chat_sender", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("chat_receiver", fields: [receiverId], references: [id])
  bookingId   String?
  message     String
  isDelivered Boolean  @default(false)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("chat_messages")
}

// ──────────────────────────────────────────────
// --- module: location ---
// ──────────────────────────────────────────────

model LocationHistory {
  id        String   @id @default(uuid())
  nurseId   String   @unique
  nurse     Nurse    @relation(fields: [nurseId], references: [id], onDelete: Cascade)
  latitude  Decimal
  longitude Decimal
  location  Unsupported("geography(Point, 4326)")?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("location_history")
}

// ──────────────────────────────────────────────
// --- module: admin ---
// ──────────────────────────────────────────────

model Service {
  id            String   @id @default(uuid())
  name          String
  description   String?
  basePrice     Decimal  @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("services")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// --- module: events (shared) ---
// ──────────────────────────────────────────────

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id              String       @id @default(uuid())
  eventType       String
  payload         Json
  idempotencyKey  String?
  status          OutboxStatus @default(PENDING)
  retryCount      Int          @default(0)
  lastError       String?
  createdAt       DateTime     @default(now())
  processedAt     DateTime?

  @@unique([eventType, idempotencyKey])
  @@map("outbox_events")
}
